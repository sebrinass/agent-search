# SearXNG 搜索引擎地址
SEARXNG_URL=http://localhost:8080

# Rerank 服务（必填，二选一）
# 本地推理（如 Ollama 跑 reranker）：
RERANK_BASE_URL=http://localhost:8863/v1
# 云端 API（Jina/Cohere/SiliconFlow/Together 等）：
# RERANK_API_KEY=sk-your-key
# RERANK_MODEL=jina-reranker-v2-base-multilingual
# RERANK_TIMEOUT_MS=30000
# 喂给 rerank 模型的单条正文长度（默认150，标题始终完整保留）
# RERANK_MAX_TEXT_LENGTH=150
# 动态过滤：低于「最高分×该比例」的结果剔除（默认0.5，0=关闭）
# RERANK_MIN_SCORE_RATIO=0.5
# 动态过滤：低于该绝对分数直接剔除（默认1.0，0=关闭；需按 rerank 模型调）
# RERANK_MIN_SCORE=1.0

# 搜索页数（默认1）
SEARCH_PAGES=1

# 返回结果数量（默认5）
TOP_K=5

# MCP HTTP 会话模式：
# - stateful（默认）：有状态，initialize 返回 mcp-session-id，
#   依赖会话的客户端（如 Hermes）可正常注册工具；适合单实例部署
# - stateless：无状态，每次请求新建实例；适合多副本/负载均衡 Docker 部署
# MCP_SESSION_MODE=stateful

# ============ MiniMax 搜索工具（minimax_search）============
# 配置了 MINIMAX_API_KEY 就自动注册 minimax_search 工具（无开关）。
# Key 在 MiniMax 平台【订阅管理 > Token Plan】获取（sk-cp- 开头）。
MINIMAX_API_KEY=
# 国内区默认 https://api.minimaxi.com；海外订阅改为 https://api.minimax.io
# MINIMAX_API_HOST=https://api.minimaxi.com
# 单次搜索超时（毫秒）
# MINIMAX_SEARCH_TIMEOUT_MS=20000

# ============ Exa 搜索工具（exa_search）============
# ENABLE_EXA_SEARCH 开关，默认 true（false 则完全不注册该工具）
# ENABLE_EXA_SEARCH=true
# 可选：Exa API key（免费注册 https://dashboard.exa.ai 送额度）
# 填了走直连 API；不填走托管匿名接口（限流，agent 会自动切换其他工具兜底）
# EXA_API_KEY=
# 单次搜索超时（毫秒）
# EXA_SEARCH_TIMEOUT_MS=20000

