# SearXNG 搜索引擎地址
SEARXNG_URL=http://localhost:8080

# Rerank 服务（必填，二选一）
# 本地推理（如 Ollama 跑 reranker）：
RERANK_BASE_URL=http://localhost:8863/v1
# 云端 API（Jina/Cohere/SiliconFlow/Together 等）：
# RERANK_API_KEY=sk-your-key
# RERANK_MODEL=jina-reranker-v2-base-multilingual
# RERANK_TIMEOUT_MS=30000
# 喂给 rerank 模型的单条正文长度（默认150，标题始终完整保留）
# RERANK_MAX_TEXT_LENGTH=150
# 动态过滤：低于「最高分×该比例」的结果剔除（默认0.5，0=关闭）
# RERANK_MIN_SCORE_RATIO=0.5
# 动态过滤：低于该绝对分数直接剔除（默认1.0，0=关闭；需按 rerank 模型调）
# RERANK_MIN_SCORE=1.0

# 搜索页数（默认1）
SEARCH_PAGES=1

# 返回结果数量（默认5）
TOP_K=5
