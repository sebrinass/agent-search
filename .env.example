# SearXNG 搜索引擎地址
SEARXNG_URL=http://localhost:8080

# 嵌入模型配置
EMBEDDING_BASE_URL=http://localhost:8863/v1
EMBEDDING_API_KEY=sk-your-key
EMBEDDING_MODEL=Jina-v5-nano

# Rerank 模型配置（与 embedding 二选一：配置了 rerank 则优先走纯 cross-encoder 重排）
# 协议兼容 Jina/Cohere/SiliconFlow/Together 的 /rerank 端点
# RERANK_BASE_URL=http://localhost:8863/v1
# RERANK_API_KEY=sk-your-key
# RERANK_MODEL=jina-reranker-v2-base-multilingual
# RERANK_TIMEOUT_MS=30000

# 搜索页数（两种模式都生效，默认1）
SEARCH_PAGES=1

# 返回结果数量（默认5）
TOP_K=5

# Lightpanda 无头浏览器（可选，用于 Read 读取动态页面/SPA）
# 设置可执行文件路径后启用；Docker 镜像内默认为 /usr/local/bin/lightpanda
# LIGHTPANDA_EXECUTABLE_PATH=/usr/local/bin/lightpanda
