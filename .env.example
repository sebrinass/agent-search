# SearXNG 搜索引擎地址
SEARXNG_URL=http://localhost:8080

# Rerank 服务（必填，二选一）
# 本地推理（如 Ollama 跑 reranker）：
RERANK_BASE_URL=http://localhost:8863/v1
# 云端 API（Jina/Cohere/SiliconFlow/Together 等）：
# RERANK_API_KEY=sk-your-key
# RERANK_MODEL=jina-reranker-v2-base-multilingual
# RERANK_TIMEOUT_MS=30000

# 搜索页数（默认1）
SEARCH_PAGES=1

# 返回结果数量（默认5）
TOP_K=5
